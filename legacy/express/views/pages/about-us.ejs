    <%
      const infraBase = 'https://storage.googleapis.com/pachin/about-us/infrastructure/';
      const infrastructure = [
        { label: 'Tinting Centers', image: infraBase + 'image%20pachin.webp' },
        { label: 'Factories', image: infraBase + 'image%20pachin2.webp' },
        { label: 'Branches', image: infraBase + 'image%20pachin4.png' },
        { label: 'Distribution Fleet', image: infraBase + 'image%20pachin3.webp' },
      ];
    %>
    <section class="py-12 md:py-16 lg:py-20 bg-gray-50">
      <section class="relative w-full py-8 md:py-12 lg:py-16">
        <div class="w-full px-[20px]">
          <div class="relative w-full rounded-[20px] sm:rounded-[30px] md:rounded-[40px] lg:rounded-[45px] overflow-hidden">
            <div class="container mx-auto px-4 mb-8">
              <h2 class="font-poppins text-black text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-center">Pachin Infrastructure</h2>
            </div>
            <div class="block min-[650px]:hidden w-full">
              <div class="flex flex-col items-center gap-6 w-full">
                <% infrastructure.forEach(function (item) { %>
                <div class="relative transition-all duration-500 ease-in-out overflow-hidden rounded-[15px] group w-[90%]">
                  <div class="relative aspect-[4/3] h-[200px] overflow-hidden mx-auto rounded-[15px]">
                    <img alt="<%= item.label %>" loading="lazy" class="object-cover rounded-[15px] transition-transform duration-500 absolute inset-0 w-full h-full" style="transform: scale(1.15)" src="<%= item.image %>" />
                  </div>
                  <div class="mt-3 md:mt-4 text-center px-2">
                    <h3 class="lg:text-4xl font-poppins text-black text-xs sm:text-sm md:text-base font-bold group-hover:text-[#f47422] transition-colors duration-300"><%= item.label %></h3>
                  </div>
                </div>
                <% }) %>
              </div>
            </div>
            <div class="hidden min-[650px]:grid min-[650px]:grid-cols-2 xl:flex xl:justify-center gap-2 xl:gap-8 px-2 xl:px-4">
              <% infrastructure.forEach(function (item) { %>
              <div class="relative transition-all duration-500 ease-in-out overflow-hidden rounded-[15px] sm:rounded-[20px] md:rounded-[25px] lg:rounded-[30px] group min-[650px]:w-[90%] xl:w-[23%] xl:flex-shrink-0">
                <div class="relative aspect-[4/3] h-[200px] sm:h-[250px] md:h-[300px] lg:h-[400px] overflow-hidden rounded-[15px]">
                  <img alt="<%= item.label %>" loading="lazy" class="object-cover rounded-[15px] sm:rounded-[20px] md:rounded-[25px] lg:rounded-[30px] transition-transform duration-500 absolute inset-0 w-full h-full" style="transform: scale(1.15)" src="<%= item.image %>" />
                </div>
                <div class="mt-3 md:mt-4 text-center px-2">
                  <h3 class="font-poppins text-black text-xs sm:text-sm md:text-base lg:text-lg xl:text-xl font-bold group-hover:text-[#f47422] transition-colors duration-300"><%= item.label %></h3>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
      </section>
    </section>
    <%
      const boardCard = 'relative bg-gradient-to-br from-purple-50 via-pink-50/80 to-purple-100/60 rounded-3xl border-2 border-purple-200 shadow-md hover:shadow-lg hover:border-purple-300 transition-all duration-200 overflow-hidden group w-full min-w-0';
      const briefcase = '<svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-5 h-5 md:w-6 md:h-6 text-purple-600 flex-shrink-0"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>';
      const boardRows = [
        { members: boardLeaders, grid: 'board-grid-2', card: 'min-h-[140px] md:min-h-[160px]', pad: 'p-6 md:p-8', name: 'text-xl md:text-2xl lg:text-3xl', role: 'text-base md:text-lg' },
        { members: boardMembers, grid: 'board-grid-3', card: 'min-h-[130px] md:min-h-[150px]', pad: 'p-5 md:p-6', name: 'text-lg md:text-xl lg:text-2xl', role: 'text-sm md:text-base lg:text-lg' },
      ];
    %>
    <section class="py-12 md:py-16 lg:py-20">
      <section class="py-8 md:py-12 lg:py-16 xl:py-20 px-4 relative overflow-hidden">
        <div class="absolute inset-0 z-0">
          <img alt="" class="object-cover absolute inset-0 w-full h-full" src="/prodcuts-bg/background_gradients%20(1).webp" />
        </div>
        <div class="container mx-auto relative z-10">
          <div class="text-center mb-8 md:mb-12 lg:mb-16 px-2">
            <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-gray-800 mb-4">Board Team</h2>
          </div>
          <% boardRows.forEach(function (row) { if (!row.members.length) return; %>
          <div class="w-full max-w-[92%] md:max-w-[88%] lg:max-w-[85%] mx-auto">
            <div class="grid <%= row.grid %> gap-4 md:gap-6 mb-8 md:mb-12 lg:mb-16">
              <% row.members.forEach(function (member) { %>
              <div class="<%= boardCard %> <%= row.card %>">
                <div class="flex gap-4 <%= row.pad %> h-full w-full min-w-0">
                  <div class="flex-1 min-w-0 flex flex-col justify-center items-center w-full overflow-hidden text-center relative">
                    <div class="mb-4 w-full flex flex-col items-center">
                      <h3 class="<%= row.name %> font-bold text-gray-900 leading-tight break-words"><%= member.name %></h3>
                    </div>
                    <div class="space-y-3 <%= row.role %> text-gray-700">
                      <div class="flex items-center justify-center gap-2"><%- briefcase %><span class="font-medium"><%= member.position %></span></div>
                    </div>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
          <% }) %>

          <div class="mb-16">
            <div class="text-center mb-8 md:mb-12 px-2">
              <h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold text-gray-800 mb-3 md:mb-4">Executive Managers</h2>
            </div>
            <div class="w-full max-w-[95%] md:max-w-[92%] lg:max-w-[90%] xl:max-w-[88%] mx-auto">
              <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 lg:gap-8 xl:gap-12">
                <% executives.forEach(function (member) { %>
                <div class="flex flex-col items-center text-center group relative">
                  <div class="relative mb-6 w-32 h-32 sm:w-40 sm:h-40 lg:w-56 lg:h-56 rounded-2xl overflow-hidden shadow-lg">
                    <img alt="<%= member.name %>" loading="lazy" class="object-cover rounded-2xl absolute inset-0 w-full h-full" src="<%= encodeURI(decodeURI(member.image)) %>" />
                  </div>
                  <h4 class="md:text-xl font-poppins mb-2 font-bold text-gray-800 group-hover:text-purple-600 transition-colors duration-300 text-xs sm:text-sm lg:text-base"><%= member.name %></h4>
                  <p class="md:text-lg font-manrope mb-2 font-semibold text-gray-700 text-[13px] sm:text-sm lg:text-base"><%= member.position %></p>
                </div>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>
  </div>
</div>
<%- include('../partials/bottom') %>
