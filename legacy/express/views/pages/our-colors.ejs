<%- include('../partials/top') %>
<%
  // Black or white label text depending on how light the swatch is
  const labelColor = (hex) => {
    const n = parseInt(String(hex).replace('#', ''), 16);
    const lum = (0.299 * ((n >> 16) & 255) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255;
    return lum > 0.6 ? '#000000' : '#ffffff';
  };
  const copyIcon = '<svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
  const rainbow = 'linear-gradient(45deg, #ef4444, #f97316, #84cc16, #22c55e, #14b8a6, #3b82f6, #8b5cf6)';
%>
<div class="bg-gray-50 min-h-screen pb-6" data-colors-page>
  <div class="relative flex flex-col md:flex-row gap-4 rounded-[20px] overflow-hidden p-3 md:p-4"
    style="width: 96%; margin: 12vh auto 0; min-height: 85vh; background-color: #f0f0f0; background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, rgba(0, 0, 0, 0.01) 2px, rgba(0, 0, 0, 0.01) 4px), repeating-linear-gradient(-45deg, transparent, transparent 2px, rgba(0, 0, 0, 0.03) 2px, rgba(0, 0, 0, 0.03) 4px)">

    <!-- Colour family filters -->
    <div class="flex md:flex-col gap-2 md:gap-3 overflow-x-auto scrollbar-hide md:w-[180px] lg:w-[220px] flex-shrink-0 md:pt-6 md:px-4">
      <button type="button" data-color-filter="" class="color-filter is-active flex items-center gap-2 md:gap-3 flex-shrink-0 px-3 md:px-4 py-2 md:py-3 rounded-full bg-white transition-all duration-200" style="border: 2px solid #e5e7eb">
        <span class="flex-shrink-0 w-5 h-5 md:w-6 md:h-6 rounded-full border border-white" style="background: <%= rainbow %>"></span>
        <span class="text-xs md:text-sm font-medium text-black whitespace-nowrap">ALL COLORS</span>
      </button>
      <% site.colorFamilies.forEach(function (family) { %>
      <button type="button" data-color-filter="<%= family.type %>" data-label="<%= family.label.toUpperCase() %>"
        class="color-filter flex items-center gap-2 md:gap-3 flex-shrink-0 px-3 md:px-4 py-2 md:py-3 rounded-full transition-all duration-200"
        style="border: 2px solid #e5e7eb; background-color: <%= family.swatch %>">
        <span class="flex-shrink-0 w-5 h-5 md:w-6 md:h-6 rounded-full border-2 border-white"></span>
        <span class="text-xs md:text-sm font-medium whitespace-nowrap" style="color: <%= labelColor(family.swatch) %>"><%= family.label.toUpperCase() %></span>
      </button>
      <% }) %>
    </div>

    <!-- Colour grid -->
    <div class="flex-1 flex flex-col bg-white rounded-2xl md:rounded-3xl overflow-hidden" style="border: 2px solid #e5e7eb">
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 px-4 pt-4 pb-2">
        <h1 data-colors-heading class="text-base md:text-xl lg:text-2xl font-bold text-black text-center">ALL COLORS (<%= colors.length %>)</h1>
        <div data-selected-color class="hidden items-center gap-2 rounded-[20px] py-1.5 px-3" style="background-color: #fef3e7; border: 2px solid #e5e7eb">
          <span data-selected-swatch class="w-5 h-5 rounded-full border border-white shadow"></span>
          <span data-selected-name class="text-sm font-bold text-black"></span>
          <button type="button" data-copy-color title="Copy color code" class="inline-flex items-center justify-center p-1 bg-white/90 hover:bg-white rounded shadow-sm border border-gray-200 w-6 h-6"><%- copyIcon %></button>
        </div>
      </div>
      <div data-colors-scroll class="flex-1 overflow-y-auto p-3 md:p-6" style="max-height: 75vh">
        <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-6 gap-1.5 md:gap-2">
          <% colors.forEach(function (color) { %>
          <button type="button" data-swatch data-type="<%= color.colorType %>" data-name="<%= color.dataColorname %>" data-hex="<%= color.hexCode %>"
            title="<%= color.dataColorname %> (<%= color.hexCode %>)"
            class="swatch rounded-md md:rounded-lg h-12 md:h-14 flex items-end justify-center pb-1 shadow-sm"
            style="background-color: <%= color.hexCode %>">
            <span class="text-[9px] sm:text-[10px] md:text-xs font-medium leading-tight" style="color: <%= labelColor(color.hexCode) %>"><%= color.dataColorname %></span>
          </button>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
