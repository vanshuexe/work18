<%- include('../partials/top', { headerTheme: 'dark' }) %>
<%
  const backIcon = (size) => `<svg class="${size}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>`;
%>
<div class="min-h-screen bg-gray-50">
  <div class="pt-20 bg-white">
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-4xl mx-auto">
        <a class="inline-flex items-center gap-2 text-orange-500 hover:text-orange-600 mb-8 transition-colors duration-200" href="/news"><%- backIcon('w-4 h-4') %>Back to News</a>
        <% if (post.tags && post.tags.length) { %>
        <div class="flex flex-wrap gap-2 mb-6">
          <% post.tags.forEach(function (tag) { %><span class="px-3 py-1 bg-orange-100 text-orange-700 text-sm rounded-full"><%= tag %></span><% }) %>
        </div>
        <% } %>
        <h1 class="sm:text-4xl lg:text-6xl font-poppins text-3xl md:text-4xl font-bold text-gray-900 mb-6"><%= post.title %></h1>
        <div class="flex items-center gap-6 text-gray-600 mb-8">
          <span class="flex items-center gap-2"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg><%= post.author %></span>
          <span class="flex items-center gap-2"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg><%= formatDate(post.datePublished) %></span>
        </div>
        <div class="relative h-64 md:h-96 w-full mb-8 rounded-2xl overflow-hidden">
          <img alt="<%= post.title %>" class="object-cover absolute inset-0 w-full h-full" src="<%= post.mainImage %>" />
        </div>
        <div class="bg-orange-50 p-6 rounded-2xl mb-8">
          <p class="sm:text-base lg:text-xl font-manrope text-[13px] md:text-lg text-gray-800 font-medium"><%= post.briefText %></p>
        </div>
      </div>
    </div>
  </div>

  <div class="py-12">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <% (post.sections || []).forEach(function (section) { %>
        <div class="mb-12">
          <% if (section.title) { %><h2 class="sm:text-3xl md:text-4xl lg:text-4xl font-poppins text-2xl font-bold text-gray-900 mb-6"><%= section.title %></h2><% } %>
          <% if (section.image) { %>
          <div class="relative h-64 md:h-80 w-full mb-6 rounded-2xl overflow-hidden">
            <img alt="<%= section.title || post.title %>" loading="lazy" class="object-cover absolute inset-0 w-full h-full" src="<%= section.image %>" />
          </div>
          <% } %>
          <div class="prose prose-lg max-w-none">
            <p class="sm:text-base lg:text-xl font-manrope text-[13px] md:text-base text-gray-700 leading-relaxed whitespace-pre-line"><%= section.content %></p>
          </div>
          <% if (section.buttonText && section.buttonLink) { %>
          <a href="<%= section.buttonLink %>" class="inline-flex items-center gap-2 mt-6 px-6 py-3 bg-orange-500 text-white rounded-full hover:bg-orange-600 transition-colors duration-200"><%= section.buttonText %></a>
          <% } %>
        </div>
        <% }) %>

        <% if (post.extraImages && post.extraImages.length) { %>
        <div class="mt-12">
          <h2 class="sm:text-3xl md:text-4xl lg:text-4xl font-poppins text-2xl font-bold text-gray-900 mb-6">Gallery</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <% post.extraImages.forEach(function (src, i) { %>
            <div class="relative h-64 rounded-2xl overflow-hidden">
              <img alt="Gallery image <%= i + 1 %>" loading="lazy" class="object-cover absolute inset-0 w-full h-full" src="<%= src %>" />
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <div class="mt-12 text-center">
          <a class="inline-flex items-center gap-2 px-8 py-4 bg-orange-500 text-white rounded-full hover:bg-orange-600 transition-colors duration-200 text-lg" href="/news"><%- backIcon('w-5 h-5') %>Back to All News</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
