<%- include('../partials/top') %>
<div class="bg-gray-50">
  <div class="w-full mx-[1%] pb-8" data-products-page data-all-label="<%= category.allLabel %>">
    <div class="w-[96%] sm:w-[98%] h-[40vh] md:h-[50vh] rounded-xl bg-cover bg-center bg-no-repeat flex items-center justify-center relative"
      style="padding-top: calc(60px + 2vh); margin-top: 2vh; background-image: url('<%= category.heroImage %>')">
      <div class="absolute inset-0 bg-black bg-opacity-40 rounded-xl"></div>
      <div class="relative z-10 text-center text-white px-4">
        <h1 class="font-poppins text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold mb-3 md:mb-4"><%= category.title %></h1>
        <p class="font-manrope text-xs sm:text-sm md:text-base lg:text-lg xl:text-xl opacity-90 mb-4 md:mb-6 px-2"><%= category.description %></p>
      </div>
    </div>

    <div class="w-full mx-[1%] py-4 md:py-8">
      <div class="w-[98%] max-w-7xl mx-auto px-2">
        <form class="relative" action="" method="get" role="search">
          <% if (activeSubcategory) { %><input type="hidden" name="subcategory" value="<%= activeSubcategory.subcategoryEn %>" /><% } %>
          <input data-product-search name="q" value="<%= query %>" placeholder="Search products by name, code, or subcategory..."
            class="w-full p-3 md:p-4 pl-10 md:pl-12 text-sm md:text-base lg:text-lg rounded-xl md:rounded-2xl transition-colors" type="search"
            style="border: 2px solid rgba(79, 39, 119, 0.3); background-color: rgba(79, 39, 119, 0.05)" />
          <div class="absolute left-3 md:left-4 top-1/2 transform -translate-y-1/2">
            <svg class="w-4 h-4 md:w-5 md:h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </form>
      </div>
    </div>

    <div class="w-full mx-[1%] pb-4 md:pb-8">
      <div class="w-[98%]">
        <div class="max-w-7xl mx-auto px-2">
          <div class="flex gap-2 md:gap-3 pb-4 overflow-x-auto scrollbar-hide">
            <a href="?" data-subcategory-filter="" title="All Products"
              class="filter-btn <%= activeSubcategory ? '' : 'is-active' %> flex-shrink-0 px-3 md:px-4 lg:px-6 py-2 md:py-3 rounded-xl md:rounded-2xl flex items-center justify-center gap-1.5 md:gap-2 transition-all duration-200 whitespace-nowrap">
              <span class="text-xs md:text-sm lg:text-base">All Products</span>
            </a>
            <% subcategories.forEach(function (sub) { %>
            <a href="?subcategory=<%= encodeURIComponent(sub.subcategoryEn.trim()) %>" data-subcategory-filter="<%= sub._id %>" data-subcategory-name="<%= sub.subcategoryEn.trim() %>" title="<%= sub.subcategoryEn.trim() %>"
              class="filter-btn <%= activeSubcategory && activeSubcategory._id === sub._id ? 'is-active' : '' %> flex-shrink-0 px-3 md:px-4 lg:px-6 py-2 md:py-3 rounded-xl md:rounded-2xl flex items-center justify-center gap-1.5 md:gap-2 transition-all duration-200 whitespace-nowrap">
              <span class="text-xs md:text-sm lg:text-base"><%= sub.subcategoryEn.trim() %></span>
            </a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>

    <div class="w-full pb-12">
      <div class="w-[94%] md:w-[98%] ml-[3%] md:ml-[1%] mr-[3%] md:mr-[1%]">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-6 md:mb-8 px-2">
            <h2 data-products-heading class="font-poppins text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold text-gray-800 mb-2">
              <%= activeSubcategory ? activeSubcategory.subcategoryEn.trim() : category.allLabel %> (<%= visibleCount %>)
            </h2>
          </div>
          <div data-products-grid class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-6">
            <% products.forEach(function (product) { %><%- include('../partials/product-card', { product, visible: isVisible(product) }) %><% }) %>
          </div>
          <div data-products-empty class="<%= visibleCount ? 'hidden' : '' %> text-center py-8 md:py-12 px-2">
            <p class="font-manrope text-xs sm:text-sm md:text-base lg:text-lg text-gray-500">No products available in this category.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/bottom') %>
